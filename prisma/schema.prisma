generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Request {
  id            String   @id @default(cuid())
  title         String
  body          String   @default("")
  author        String   @default("")
  slackNotified Boolean  @default(false)
  createdAt     DateTime @default(now())
}
