# Copy to .env and fill in. Do not commit .env.

# SQLite file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Optional. If set, /login is required.
APP_PASSWORD=

# Slack Incoming Webhook URL (server only)
SLACK_WEBHOOK_URL=

# Teams Incoming Webhook URL (server only)
TEAMS_WEBHOOK_URL=
